{
  "name": "astro-theme-popular",
  "version": "0.11.0",
  "description": "Popular: a warm, community-first Astro theme for meetups, user groups and small events. Built to make your community seen and famous.",
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "package",
    "create-popular-site",
    "demos/*",
    "smoke"
  ],
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "demo:starter": "npm run dev --workspace demos/starter",
    "demo:superfan": "npm run dev --workspace demos/superfan",
    "demo:aquarium": "npm run dev --workspace demos/aquarium",
    "demo:foodie": "npm run dev --workspace demos/foodie",
    "demo:kdrama": "npm run dev --workspace demos/kdrama",
    "demos:build": "npm run build --workspaces --if-present"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.2",
    "@astrojs/rss": "^4.0.0",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.0.6"
  }
}
