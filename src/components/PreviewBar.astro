---
/** PreviewBar: fixed banner rendered ONLY when the config sets
 *  `SITE.previewMode` (a generator's throwaway build, shown in an iframe). The
 *  config written into an adopter's own repo never sets it, so the banner is
 *  structurally incapable of reaching a real site.
 *
 *  Informational only, no controls: a preview is served with
 *  `sandbox="allow-scripts"` and no allow-same-origin, so a button here could
 *  not drive the surrounding page. Actions belong in the chrome outside the
 *  iframe. Unlike DemoBar this renders in dev too: someone running the same
 *  config locally is previewing as well. Twin of Hugo's preview-bar.html.
 *
 *  previewMode accepts `true` or `{ note: 'Expires in 60 minutes.' }`.
 */
import { SITE, STRINGS } from '../config';
const preview = (SITE as Record<string, any>).previewMode ?? null;
const note = typeof preview === 'object' && preview ? preview.note : undefined;
---

{preview && (
  <>
    <style>
      .g-previewbar { position: fixed; bottom: 14px; left: 50%; transform: translateX(-50%); z-index: 90;
        display: flex; align-items: center; gap: 8px; padding: 8px 16px; max-width: calc(100vw - 28px);
        background: color-mix(in srgb, var(--ink-900) 92%, transparent); color: var(--ink-200);
        border-radius: var(--radius-pill); box-shadow: var(--shadow-lg); font-size: var(--text-xs);
        font-family: var(--font-sans); backdrop-filter: blur(8px); }
      .g-previewbar__label { color: var(--ink-400); font-weight: var(--weight-semibold);
        letter-spacing: var(--tracking-wide); text-transform: uppercase; font-size: 0.65rem; }
      .g-previewbar__note { color: var(--ink-400); }
      @media (max-width: 640px) { .g-previewbar__label { display: none; } }
      /* Reserve space so the fixed bar never covers the footer credit. */
      .g-footer__bottom { padding-bottom: 72px; }
    </style>
    <div class="g-previewbar" role="status">
      <i class="fa-solid fa-eye" aria-hidden="true"></i>
      <span class="g-previewbar__label">{STRINGS.previewLabel}</span>
      <span>{STRINGS.previewBanner}</span>
      {note && <span class="g-previewbar__note">{note}</span>}
    </div>
  </>
)}
