---
/** §7: "Your name here?" invite card appended to the speakers list when
 *  SITE.speakers.invite is true. Links to the /speak/ CFP page. Off by
 *  default, so sites that do not solicit talks show nothing. */
import { SITE, STRINGS } from '../config';
const invite = (SITE as Record<string, any>).speakers?.invite === true;
---
{invite && (
  <div class="g-persona g-persona--primary">
    <span class="g-medallion g-medallion--lg" aria-hidden="true"><i class="fa-solid fa-microphone-lines"></i></span>
    <div>
      <div class="g-persona__name"><a href="/speak/" style="color:inherit">{STRINGS.speakerInviteTitle} <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a></div>
      <p class="g-persona__bio">{STRINGS.speakerInviteBody}</p>
    </div>
  </div>
)}
