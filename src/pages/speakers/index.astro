---
/** Speakers list, mirroring Hugo's layouts/speakers/list.html: every speaker
 *  rendered as an AuthorBox, sorted by name. Fixes the "All speakers" backlink
 *  on speaker detail pages, which previously had no list page to point to. */
import { safeCollection } from '../../lib/collections';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import AuthorBox from '../../components/AuthorBox.astro';
import SpeakerInvite from '../../components/SpeakerInvite.astro';
import { SECTIONS } from '../../config';

const speakers = (await safeCollection('speakers')).sort((a, b) => a.data.title.localeCompare(b.data.title));
const sec = SECTIONS.speakers;
---

<BaseLayout title={sec.title} description={sec.lead}>
  <PageHero eyebrow={sec.eyebrow} title={sec.title} lead={sec.lead} />
  <section class="g-bg-white g-section">
    <div class="g-container">
      <div class="g-stack" style="max-width:52rem;gap:var(--space-3)">
        {speakers.map((s) => <AuthorBox entry={s} base="/speakers/" />)}
        <SpeakerInvite />
      </div>
    </div>
  </section>
</BaseLayout>
