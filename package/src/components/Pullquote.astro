---
/** Pull-quote (§6): a styled blockquote with optional attribution. Mirrors the
 *  Hugo `pullquote` shortcode. Use in MDX:
 *    <Pullquote cite="A happy member">The best Tuesday of my month.</Pullquote> */
interface Props { cite?: string; }
const { cite } = Astro.props;
---
<figure class="g-pullquote">
  <blockquote><slot /></blockquote>
  {cite && <figcaption>{cite}</figcaption>}
</figure>
