---
/** Site-wide notice banner (§5). Reads optional SITE.notice = { text, url? }.
 *  Static, not dismissible, no JS. Rendered by BaseLayout above the header.
 *  Text is inline-markdown rendered (parity with Hugo's notice.html). */
import { SITE, STRINGS } from 'popular:config';
import { inlineMarkdown } from '../lib/inline-md';

const notice = (SITE as Record<string, any>).notice;
const text: string | undefined = notice?.text;
const html = text ? inlineMarkdown(text) : '';
---
{text && (
  <div class="g-notice" role="status">
    <div class="g-notice__inner">
      <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
      <span><Fragment set:html={html} />{notice.url && <> <a href={notice.url}>{STRINGS.learnMore}</a></>}</span>
    </div>
  </div>
)}
