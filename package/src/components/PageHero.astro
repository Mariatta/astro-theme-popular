---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  backHref?: string;
  backLabel?: string;
}
const { eyebrow, title, lead, backHref, backLabel } = Astro.props;
---

<header class="g-pagehero">
  <div class="g-container">
    {backHref && (
      <div style="margin-bottom:1rem"><a href={backHref} style="display:inline-flex;gap:.4rem;align-items:center;font-size:var(--text-sm);font-weight:var(--weight-medium)"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> {backLabel}</a></div>
    )}
    {eyebrow && <span class="g-eyebrow">{eyebrow}</span>}
    <h1>{title}</h1>
    {lead && <p class="g-pagehero__lead">{lead}</p>}
    {Astro.slots.has('default') && (
      <div class="g-row" style="margin-top:var(--space-4)"><slot /></div>
    )}
  </div>
</header>
