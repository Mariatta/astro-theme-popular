---
/** Designed empty state for zero upcoming events (§5). Shown on the home page
 *  and events list instead of a blank section: a message, then the chat CTA
 *  (if SITE.community.chat is set, §4) and the calendar-subscribe link.
 *  The calendar link mirrors Hugo's OutputFormats "Calendar" endpoint. */
import { SITE, STRINGS } from 'popular:config';
import { withBase } from '../lib/url';

const chat = (SITE as Record<string, any>).community?.chat;
const calendar = '/events/calendar.ics';
const external = (url: string) => !url.startsWith('/');
---
<div class="g-empty">
  <span class="g-medallion g-medallion--lg"><i class="fa-solid fa-calendar-day" aria-hidden="true"></i></span>
  <p class="g-lead">{STRINGS.noUpcomingEvents}</p>
  {(chat?.url || calendar) && (
    <div class="g-row" style="justify-content:center">
      {chat?.url && (
        <a class="g-btn g-btn--primary" href={withBase(chat.url)} {...(external(chat.url) ? { rel: 'noopener', target: '_blank' } : {})}>
          <i class="fa-solid fa-comments" aria-hidden="true"></i> {chat.label ?? STRINGS.joinChat}
        </a>
      )}
      <a class="g-btn g-btn--outline" href={withBase(calendar)}><i class="fa-solid fa-calendar-plus" aria-hidden="true"></i> {STRINGS.subscribeCalendar}</a>
    </div>
  )}
</div>
