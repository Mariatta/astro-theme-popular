---
/** Calendar subscribe buttons for the events feed: a webcal link that opens
 *  the user's calendar app subscribed to the live feed (Apple Calendar,
 *  Outlook, Thunderbird), a Google Calendar deep link (Google registers no
 *  webcal handler on the web or Android), and the plain .ics download as the
 *  universal fallback for "add calendar from URL" flows. webcal needs an
 *  absolute URL, so the feed path goes through absoluteUrl. Mirrors Hugo's
 *  partials/calendar-subscribe.html; callers supply the wrapping .g-row. */
import { STRINGS } from 'popular:config';
import { withBase, absoluteUrl } from '../lib/url';

interface Props {
  small?: boolean;
}
const { small = false } = Astro.props;

const feedPath = '/events/calendar.ics';
const webcal = absoluteUrl(feedPath, Astro.site ?? Astro.url).replace(/^https?:/, 'webcal:');
const google = `https://calendar.google.com/calendar/render?cid=${encodeURIComponent(webcal)}`;
const size = small ? ' g-btn--sm' : '';
---
<a class={`g-btn g-btn--outline${size}`} href={webcal}><i class="fa-solid fa-calendar-plus" aria-hidden="true"></i> {STRINGS.subscribeCalendar}</a>
<a class={`g-btn g-btn--outline${size}`} href={google} rel="noopener" target="_blank"><i class="fa-brands fa-google" aria-hidden="true"></i> {STRINGS.subscribeGoogle}</a>
<a class={`g-btn g-btn--ghost${size}`} href={withBase(feedPath)} download><i class="fa-solid fa-download" aria-hidden="true"></i> {STRINGS.downloadCalendar}</a>
