baseURL = "${base_url|https://example.com/}"
enableRobotsTXT = true
title = "${community_name|Your Community}"
theme = "hugo-theme-popular"

# Events use real future dates; without this Hugo drops upcoming events.
buildFuture = true

[taxonomies]
  tag = "tags"

[markup.goldmark.renderer]
  unsafe = true

[[menu.main]]
  name = "About"
  url = "/about/"
  weight = 10
[[menu.main]]
  name = "Blog"
  url = "/blog/"
  weight = 20
[[menu.main]]
  name = "Events"
  url = "/events/"
  weight = 30

[params]
  tagline = "${tagline|A warm welcome to your community}"
  description = "${tagline|A warm welcome to your community}"
  brandName = "${community_name|Your Community}"
  logo = "${logo|images/logo.png}"

  [params.cta]
    label = "RSVP"
    url   = "${rsvp_home|https://example.com/rsvp}"
    icon  = "fa-solid fa-calendar"

# popular:if chat
  [params.community.chat]
    url   = "${chat}"
    label = "Join the chat"
# popular:end
# popular:if speakers_invite
  [params.speakers]
    invite = true
# popular:end
# popular:if coc_contact
  [params.coc]
    contact = "${coc_contact}"
# popular:end

# popular:social

  [params.footer]
    tagline = "${tagline|A warm welcome to your community}"
    [params.footer.credit]
      label = "Popular. A Hugo theme by Mariatta."
      url   = "https://popular.mariatta.ca/"

[mediaTypes."text/calendar"]
  suffixes = ["ics"]

[outputFormats.Calendar]
  mediaType = "text/calendar"
  baseName = "calendar"
  isPlainText = true
  noUgly = true

[outputs]
  home = ["HTML", "RSS", "LLMS"]
