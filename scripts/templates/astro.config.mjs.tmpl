import { defineConfig } from 'astro/config';
import mdx from '@astrojs/mdx';
import sitemap from '@astrojs/sitemap';
import popularMarkdown from './popular-markdown.mjs';

/* `site` is your origin and `base` is the path your site is served from.
   A GitHub project page lives at you.github.io/my-community/, so its base is
   '/my-community'; leave it '/' for a site at a domain root. Every link,
   image and feed URL the theme writes follows both (src/lib/url.ts), and so
   do links and images inside markdown bodies (popular-markdown.mjs, which
   reads the resolved config, so `astro build --base ...` works too).
   scripts/setup.py writes this file from your answers. */
export default defineConfig({
  site: '${__astro_site|https://example.com}',
  base: '${__astro_base|/}',
  integrations: [mdx(), sitemap(), popularMarkdown()],
});